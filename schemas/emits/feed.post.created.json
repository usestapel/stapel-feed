{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feed.post.created",
  "description": "A post was published. Identity only: the body never rides the bus. Key = post id.",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "followers"
      ]
    }
  },
  "required": [
    "post_id",
    "author_id",
    "visibility"
  ],
  "additionalProperties": false
}
