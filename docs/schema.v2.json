      "ImageObject": {
        "type": "object",
        "description": "The fleet's one image object (stapel-cdn's describe vocabulary).\n\n``variants`` items are core's ``VariantMeta`` (the component profiles'\n``StapelImage`` carries), and ``url`` is the default rendition — the\n``original`` rung, else the largest — or ``null`` when the ladder is\nempty, so a renderer draws it without parsing the ladder.",
        "properties": {
          "ref": {
            "type": "string",
            "maxLength": 255
          },
          "mime": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "ext": {
            "type": "string",
            "nullable": true,
            "maxLength": 16
          },
          "bytes": {
            "type": "integer",
            "nullable": true
          },
          "width": {
            "type": "integer",
            "nullable": true
          },
          "height": {
            "type": "integer",
            "nullable": true
          },
          "aspect": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "square": {
            "type": "boolean",
            "nullable": true
          },
          "animated": {
            "type": "boolean",
            "nullable": true
          },
          "preview_b64": {
            "type": "string",
            "nullable": true,
            "maxLength": 16384
          },
          "preview_kind": {
            "type": "string",
            "nullable": true,
            "maxLength": 32
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VariantMeta"
            }
          },
          "url": {
            "type": "string",
            "nullable": true,
            "maxLength": 2048
          },
          "meta_status": {
            "$ref": "#/components/schemas/ImageMetaStatusEnum"
          },
          "meta_reason": {
            "type": "string",
            "nullable": true,
            "maxLength": 64
          }
        },
        "required": [
          "animated",
          "aspect",
          "bytes",
          "ext",
          "height",
          "meta_reason",
          "meta_status",
          "mime",
          "preview_b64",
          "preview_kind",
          "ref",
          "square",
          "url",
          "variants",
          "width"
        ]
      },
